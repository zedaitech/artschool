# Compiled / generated at runtime — Laravel recreates these on the server.
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!**/.gitkeep

# Stray backup left by a composer run.
composer.lock.bak
